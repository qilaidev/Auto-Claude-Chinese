{
  "name": "auto-claude",
  "version": "2.6.6",
  "description": "Autonomous multi-agent coding framework powered by Claude AI",
  "license": "AGPL-3.0",
  "author": "Auto Claude Team",
  "scripts": {
    "install:backend": "node scripts/install-backend.js",
    "install:frontend": "cd auto-claude-ui && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "start": "cd auto-claude-ui && npm run build && npm run start",
    "dev": "cd auto-claude-ui && npm run dev",
    "dev:debug": "cd auto-claude-ui && npm run dev:debug",
    "dev:mcp": "cd auto-claude-ui && npm run dev:mcp",
    "build": "cd auto-claude-ui && npm run build",
    "lint": "cd auto-claude-ui && npm run lint",
    "test": "cd auto-claude-ui && npm test",
    "test:backend": "node scripts/test-backend.js",
    "package": "cd auto-claude-ui && npm run package",
    "package:mac": "cd auto-claude-ui && npm run package:mac",
    "package:win": "cd auto-claude-ui && npm run package:win",
    "package:linux": "cd auto-claude-ui && npm run package:linux"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tytsxai/Auto-Claude-Chinese.git"
  },
  "keywords": [
    "ai",
    "claude",
    "autonomous",
    "coding",
    "agents",
    "electron"
  ]
}
